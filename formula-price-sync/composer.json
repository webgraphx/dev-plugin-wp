{
  "name": "webgraphx/formula-price-sync",
  "description": "WooCommerce automated pricing by gold & currency formulas",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "WebGraphx",
      "homepage": "https://webgraphx.ir"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "FPS\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FPS\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test:phpunit": "phpunit",
    "test:phpcs": "phpcs",
    "test:all": [
      "@test:phpcs",
      "@test:phpunit"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
